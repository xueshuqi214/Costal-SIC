/* Coastal SIC — 现代化桌面样式表
   配色：深海蓝主色 + 湿地青绿强调色，浅色背景，强调可读性。
*/

QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #1f2933;
}

QMainWindow, QDialog {
    background-color: #f4f7fa;
}

/* ---------- 侧边导航 ---------- */
#SideBar {
    background-color: #0f2f45;
    border: none;
}

#SideBarTitle {
    color: #ffffff;
    font-size: 17px;
    font-weight: 600;
    padding: 22px 20px 4px 20px;
}

#SideBarSubtitle {
    color: #8fb3c9;
    font-size: 11px;
    padding: 0 20px 18px 20px;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #b9d2e2;
    border: none;
    border-left: 3px solid transparent;
    padding: 13px 20px;
    text-align: left;
    font-size: 13px;
}

QPushButton#NavButton:hover {
    background-color: #17435f;
    color: #ffffff;
}

QPushButton#NavButton:checked {
    background-color: #1b5476;
    color: #ffffff;
    border-left: 3px solid #2ec4b6;
    font-weight: 600;
}

#SideBarVersion {
    color: #6d8ea4;
    font-size: 11px;
    padding: 14px 20px 18px 20px;
}

/* ---------- 卡片 ---------- */
QFrame#Card {
    background-color: #ffffff;
    border: 1px solid #e3eaf1;
    border-radius: 10px;
}

QFrame#CardAccent {
    background-color: #ffffff;
    border: 1px solid #d6e4ee;
    border-left: 4px solid #2ec4b6;
    border-radius: 10px;
}

QLabel#PageTitle {
    font-size: 22px;
    font-weight: 600;
    color: #0f2f45;
}

QLabel#PageSubtitle {
    font-size: 13px;
    color: #64798a;
}

QLabel#SectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #17435f;
}

QLabel#Hint {
    color: #7b8fa0;
    font-size: 12px;
}

QLabel#ValueLarge {
    font-size: 20px;
    font-weight: 600;
    color: #0f2f45;
}

QLabel#ValueSmall {
    font-size: 12px;
    color: #64798a;
}

QLabel#HeroTitle {
    font-size: 30px;
    font-weight: 700;
    color: #0f2f45;
}

QLabel#HeroSubtitle {
    font-size: 14px;
    color: #5b7386;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #eef3f8;
    color: #17435f;
    border: 1px solid #d3e0ea;
    border-radius: 7px;
    padding: 9px 18px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #e2ecf4;
    border-color: #b9cfe0;
}

QPushButton:pressed {
    background-color: #d5e3ee;
}

QPushButton:disabled {
    background-color: #f2f5f8;
    color: #a9b7c3;
    border-color: #e4eaf0;
}

QPushButton#PrimaryButton {
    background-color: #0f6e8c;
    color: #ffffff;
    border: 1px solid #0f6e8c;
    font-weight: 600;
    padding: 11px 26px;
}

QPushButton#PrimaryButton:hover {
    background-color: #12809f;
    border-color: #12809f;
}

QPushButton#PrimaryButton:pressed {
    background-color: #0b5b74;
}

QPushButton#PrimaryButton:disabled {
    background-color: #b9cedb;
    border-color: #b9cedb;
    color: #f4f8fa;
}

QPushButton#DangerButton {
    background-color: #fff1f0;
    color: #c0392b;
    border: 1px solid #f3c9c4;
}

QPushButton#DangerButton:hover {
    background-color: #ffe6e3;
}

QPushButton#DatasetButton {
    background-color: #ffffff;
    border: 1px solid #d3e0ea;
    border-radius: 10px;
    padding: 18px;
    text-align: left;
    font-size: 14px;
    font-weight: 600;
    color: #17435f;
}

QPushButton#DatasetButton:hover {
    border-color: #2ec4b6;
    background-color: #f7fdfc;
}

QPushButton#DatasetButton:checked {
    border: 2px solid #2ec4b6;
    background-color: #f0fbf9;
    color: #0f5b6e;
}

/* ---------- 输入控件 ---------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d3e0ea;
    border-radius: 7px;
    padding: 8px 10px;
    selection-background-color: #2ec4b6;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2ec4b6;
}

QLineEdit:read-only {
    background-color: #f6f9fb;
    color: #4a6272;
}

QLineEdit:disabled, QComboBox:disabled {
    background-color: #f2f5f8;
    color: #a9b7c3;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d3e0ea;
    selection-background-color: #e8f6f4;
    selection-color: #0f2f45;
    outline: none;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background-color: #e7eef4;
    border: none;
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: #17435f;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #2ec4b6;
    border-radius: 6px;
}

/* ---------- 日志框 ---------- */
QPlainTextEdit#LogView {
    background-color: #0e2534;
    color: #cfe3ef;
    border: 1px solid #17384e;
    border-radius: 8px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    padding: 8px;
}

/* ---------- 表格 ---------- */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e3eaf1;
    border-radius: 8px;
    gridline-color: #eef3f8;
    selection-background-color: #e8f6f4;
    selection-color: #0f2f45;
}

QHeaderView::section {
    background-color: #f4f8fb;
    color: #4a6272;
    border: none;
    border-bottom: 1px solid #e3eaf1;
    padding: 8px;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c8d8e4;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #a9c1d3;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #c8d8e4;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- 提示气泡 ---------- */
QToolTip {
    background-color: #0f2f45;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 6px 9px;
}
